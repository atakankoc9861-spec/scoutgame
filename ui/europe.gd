static func view_for(cc: String) -> Rect2:
	## Ülkenin şehirlerini kapsayan (boylam, enlem) dikdörtgeni; Türkiye için eski kadraj
	if cc == "TR":
		return Rect2(25.6, 35.6, 45.0 - 25.6, 42.3 - 35.6)
	var pts := []
	for city in Data.CITY_W:
		var c: Array = Data.CITY_W[city]
		if str(c[2]) == cc:
			pts.append(Vector2(float(c[1]), float(c[0])))
	if pts.is_empty():
		return Rect2(-10, 35, 50, 30)
	var cap: Vector2 = pts[0]
	var mn: Vector2 = cap
	var mx: Vector2 = cap
	for p in pts:
		# çok uzak şehirler (Uzak Doğu) kadrajı bozmasın
		if absf(p.x - cap.x) > 11.0 or absf(p.y - cap.y) > 9.0:
			continue
		mn = Vector2(minf(mn.x, p.x), minf(mn.y, p.y))
		mx = Vector2(maxf(mx.x, p.x), maxf(mx.y, p.y))
	var c := (mn + mx) / 2.0
	var span := maxf((mx.x - mn.x) * 1.35, (mx.y - mn.y) * 1.35 * 1.6)
	span = clampf(span, 5.0, 34.0)
	return Rect2(c.x - span / 2.0, c.y - span / 2.0 / 1.6, span, span / 1.6)
