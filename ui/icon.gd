extends Control
## Vektör ikonlar (font bağımsız, her telefonda aynı görünür).

var icon := "home"
var color := Color.WHITE
var thick := 2.6

func setup(name: String, col: Color, sz := 32.0) -> Control:
	icon = name
	color = col
	custom_minimum_size = Vector2(sz, sz)
	mouse_filter = Control.MOUSE_FILTER_IGNORE
	queue_redraw()
	return self

func set_color(c: Color) -> void:
	color = c
	queue_redraw()

func _p(x: float, y: float) -> Vector2:
	var s := minf(size.x, size.y)
	var o := (size - Vector2(s, s)) / 2.0
	return o + Vector2(x, y) * s

func _line(pts: Array, closed := false) -> void:
	var arr := PackedVector2Array()
	for p in pts:
		arr.append(_p(p[0], p[1]))
	if closed:
		arr.append(arr[0])
	draw_polyline(arr, color, thick * minf(size.x, size.y) / 32.0, true)

func _poly(pts: Array, col := Color.TRANSPARENT) -> void:
	var arr := PackedVector2Array()
	for p in pts:
		arr.append(_p(p[0], p[1]))
	draw_colored_polygon(arr, color if col == Color.TRANSPARENT else col)

func _circle(x: float, y: float, r: float, filled := false) -> void:
	var s := minf(size.x, size.y)
	if filled:
		draw_circle(_p(x, y), r * s, color)
	else:
		draw_arc(_p(x, y), r * s, 0, TAU, 32, color, thick * s / 32.0, true)

